# Copy to `.env.local` for local dev. Never commit `.env*` files.

# Same API key the backend expects. Sent as the `X-API-Key` header.
VITE_API_KEY=CHANGE_ME_TO_MATCH_BACKEND_API_KEY

# Backend base URL (no trailing slash). LEAVE BLANK for the normal setup: in dev the Vite
# proxy forwards /api -> http://localhost:3124 (same-origin, no CORS), and in production
# nginx proxies /api -> the api service (same-origin). Only set this for a split-origin
# deploy where the API is on a different origin than the frontend (then also add that
# frontend origin to the backend's ALLOWED_ORIGINS).
VITE_API_BASE_URL=
