# Copy to `.env.local` for local dev. Never commit `.env*` files.

# Same API key the backend expects. Sent as the `X-API-Key` header.
VITE_API_KEY=CHANGE_ME_TO_MATCH_BACKEND_API_KEY

# Backend base URL (no trailing slash). Leave blank in production when the
# frontend is served behind the same reverse proxy as the API.
VITE_API_BASE_URL=http://localhost:3124
